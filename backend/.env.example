GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EXTRACTION_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=policy-pdfs
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional loopback-only development origin pattern. Production origins belong
# in CORS_ORIGINS above.
CORS_ORIGIN_REGEX=^https?://(localhost|127\\.0\\.0\\.1)(:\\d+)?$
MAX_UPLOAD_BYTES=26214400
ANALYSIS_STALE_AFTER_SECONDS=1800
