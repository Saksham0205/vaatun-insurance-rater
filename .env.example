# Backend API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BUCKET=policy-pdfs
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=26214400
ANALYSIS_STALE_AFTER_SECONDS=1800

# Next.js browser-safe Supabase configuration. These are public values, not secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Gemini is intentionally not used by the deterministic foundation milestone.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
